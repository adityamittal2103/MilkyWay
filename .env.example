# Copy to .env.local for development; set the same keys in Vercel for production.

# Supabase: where registrations are stored (server only, never exposed to the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret key: sb_secret_… or the legacy service_role key>

# Optional: also send each registration to a webhook (Sheets / Zapier / CRM)
REGISTRATION_WEBHOOK_URL=

# The public address of the site (canonical URLs, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://milkyway.vercel.app
